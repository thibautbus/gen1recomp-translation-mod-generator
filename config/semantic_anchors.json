    "%s got off\nthe BICYCLE.": {
      "parts": [
        {"qid": "rb.text_7.GotOffBicycleText1", "extraction": {"kind": "full"}},
        {"qid": "rb.text_7.GotOffBicycleText2", "extraction": {"kind": "full"}},
        {"qid": "rb.names.ItemNames.6", "extraction": {"kind": "full"}, "include": false}
      ],
      "join": "\n",
      "placeholders": {"{PLAYER}": "%s", "{RAM:wStringBuffer}": {"part": 2}}
